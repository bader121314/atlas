# Local-only values; choose your own passwords before starting Compose.
NODE_ENV=development
API_PORT=3001
# Trust X-Forwarded-For from a proxy on this machine (the web server): loopback.
# Unset trusts no proxy. See ADR-040.
TRUST_PROXY=loopback
WORKER_PORT=3002
# Bearer token for GET /v1/metrics on the API and worker (16+ characters). ADR-041.
METRICS_TOKEN=
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://atlas:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/atlas
REDIS_URL=redis://127.0.0.1:6379
MINIO_ROOT_USER=atlas-local
MINIO_ROOT_PASSWORD=
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Exact browser origin of the web app; state-changing requests must match it.
WEB_ORIGIN=http://localhost:3000
