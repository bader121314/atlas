# Local-only values; choose your own passwords before starting Compose.
NODE_ENV=development
API_PORT=3001
# Trust X-Forwarded-For from a proxy on this machine (the web server): loopback.
# Unset trusts no proxy. See ADR-040.
TRUST_PROXY=loopback
WORKER_PORT=3002
# Bearer token for GET /v1/metrics on the API and worker (16+ characters). ADR-041.
METRICS_TOKEN=
POSTGRES_USER=atlas
POSTGRES_DB=atlas
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://atlas:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/atlas
REDIS_URL=redis://127.0.0.1:6379
MINIO_ROOT_USER=atlas-local
MINIO_ROOT_PASSWORD=
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Exact browser origin of the web app; state-changing requests must match it.
WEB_ORIGIN=http://localhost:3000
# Webhooks (ADR-036): 32+ random characters seal endpoint secrets.
# WEBHOOK_ALLOW_HTTP permits http:// endpoints in development only.
WEBHOOK_SECRET_KEY=
# Single sign-on (ADR-058): 32+ characters to seal identity provider client
# secrets; SSO is unavailable while empty. SSO_ALLOW_HTTP and
# SSO_ALLOWED_HOSTS relax provider address rules in development only.
SSO_SECRET_KEY=
SSO_ALLOW_HTTP=false
SSO_ALLOWED_HOSTS=
# Browser push (ADR-060): base64url P-256 keys and a contact for push
# services. Push is off while empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
WEBHOOK_ALLOW_HTTP=true
# Attachments and exports (ADR-034). For local MinIO, create the bucket in the
# console (http://127.0.0.1:9001) and use the root credentials above.
# Leave the secret empty to run without file features.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=atlas
STORAGE_ACCESS_KEY=atlas-local
STORAGE_SECRET_KEY=
# Unread notifications are emailed after this delay (ADR-031).
NOTIFICATION_EMAIL_DELAY_MS=120000
