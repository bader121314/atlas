{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run build --filter=./packages/* && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run build --filter=./packages/* && vitest run --project unit",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project integration",
    "db:validate": "node --env-file-if-exists=.env scripts/database.mjs validate",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:generate": "node --env-file-if-exists=.env scripts/database.mjs generate",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo-seed.mjs"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "pg": "8.23.1",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "@nestjs/platform-express": "11.2.10"
  }
}
