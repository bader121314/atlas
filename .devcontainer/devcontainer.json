{
  // Run Atlas in GitHub Codespaces or any dev container (ADR-062):
  // dependencies start with Docker, then `pnpm dev` serves the app on 3000.
  "name": "Atlas",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Atlas", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "docker compose up -d postgres redis",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
